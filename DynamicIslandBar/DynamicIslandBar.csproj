<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RBar</AssemblyName>
    <RootNamespace>DynamicIslandBar</RootNamespace>
    <StartupObject>DynamicIslandBar.Program</StartupObject>
    <Product>RBar</Product>
    <Company>rainwave</Company>
    <Authors>rainwave</Authors>
    <Description>RBar transparent capsule desktop companion for Windows 11.</Description>
    <Copyright>Copyright © 2026 rainwave</Copyright>
    <ApplicationIcon>Assets\UI-Win-AppIcon.ico</ApplicationIcon>
    <SatelliteResourceLanguages>zh-Hans;zh-Hant;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\UI-Win-AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ControlCenter-DefaultLandscape.jpg" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
